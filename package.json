{
  "name": "automapper",
  "version": "1.0.0",
  "private": true,
  "description": "Universal osu!mania converter and automapper: StepMania (.sm/.ssc) to .osz",
  "license": "GPL-3.0-only",
  "type": "module",
  "bin": {
    "converter": "dist/src/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-ui-page.mjs",
    "build:exe": "node scripts/build-sea.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ui": "npm run build && node dist/src/ui/server.js",
    "convert": "tsx src/cli/index.ts",
    "convert:built": "node dist/src/cli/index.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
